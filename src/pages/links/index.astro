---
import PageLayout from '@/layouts/PageLayout.astro'
import { friendLinks } from '@/data/links'
---

<!-- Apple Liquid Glass: index/list page archetype (patterns.md §B) --><!-- Unified panel list grouped by category with hairline dividers, not fragmented cards -->
<PageLayout>
  <div class="max-w-[1100px] px-4 md:px-8 py-20 mx-auto">
    <div class="mb-10 text-center">
      <h1 class="text-4xl font-bold">友链</h1>
      <p class="mt-2 text-secondary">认识我的朋友们</p>
    </div>

    {
      friendLinks.map((group) => (
        <div class="mb-10">
          <div class="mb-4 flex items-center gap-3">
            <h2 class="text-lg font-bold">{group.title}</h2>
            <div class="h-px flex-1 bg-border" />
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
            {group.links.map((f) => (
              <a
                href={f.url}
                target="_blank"
                rel="noopener"
                class="group flex items-center gap-4 rounded-xl border border-primary/20 bg-secondary/30 p-4 transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-accent/10"
              >
                <img
                  src={f.avatar}
                  alt={f.name}
                  class="h-12 w-12 flex-shrink-0 rounded-full object-cover"
                  loading="lazy"
                />
                <div class="min-w-0 flex-1">
                  <p class="truncate font-medium group-hover:text-accent">{f.name}</p>
                  {f.desc && <p class="truncate text-xs text-secondary">{f.desc}</p>}
                  <p class="truncate text-xs text-secondary/60">{new URL(f.url).hostname}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</PageLayout>
