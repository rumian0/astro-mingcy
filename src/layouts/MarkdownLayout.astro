---
import Layout from './Layout.astro'
import { HeadGradient } from '@/components/head-gradient'
import Footer from '@/components/footer/Footer.astro'
import Navbar from '@/components/header/Navbar.astro'
import { Provider } from '@/components/provider/Provider'
import ParticlesBg from '@/components/background/ParticlesBg'
import CommentFAB from '@/components/post/CommentFAB.astro'
import 'katex/dist/katex.min.css'

interface Props {
  title: string
  description?: string
  image?: string
  mdTitle: string
  mdDescription: string
  mdSlug: string
}

const { title, description, image, mdTitle, mdDescription, mdSlug } = Astro.props
---

<Layout title={title} description={description} image={image}>
  <Provider
    pathName={Astro.url.pathname}
    title={mdTitle}
    description={mdDescription}
    slug={mdSlug}
    client:only="react"
  />

  <Navbar />
  <main class="relative z-1 pt-16 min-h-main bg-primary/60">
    <HeadGradient client:idle />
    <CommentFAB />
    <div class="swup-transition-fade relative">
      <ParticlesBg client:visible />
      <div class="relative z-1">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</Layout>
