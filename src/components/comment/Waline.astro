---
// Waline 评论容器 + 视觉覆盖
// ───────────────────────────────────────────────
// 初始化不在这里：由 Layout.astro 的「评论驱动控制器」（body 级常驻脚本）
// 在用户切到 Waline 时按需 import('/waline/waline.js') 并 init。
// 原因：Swup 切页不重建 Layout（控制器常驻、可复用实例），
//       但会整体替换 main（main 内的脚本由 SwupScriptsPlugin 每次重跑，
//       若在此处初始化会每切一篇就新建一个实例且旧的永不销毁 → 内存泄漏）。
// 视觉：用 --waline-* 变量对齐现有 Twikoo 的语言（accent 强调、1rem 大圆角、
//       半透明底、细边框、时间戳淡化），并把 --waline-theme-color 指向站内
//       随机 accent，因此跟随每页随机强调色与明暗模式自动切换。
---

<div id="waline" class="comment-driver" data-engine="waline"></div>

<style is:global>
  /* ─── 主题变量（浅色） ─── */
  #waline {
    --waline-theme-color: rgb(var(--color-accent));
    --waline-active-color: rgb(var(--color-accent));
    --waline-color: rgb(var(--color-text-primary));
    --waline-bg-color: rgb(var(--color-bg-primary));
    --waline-bg-color-light: rgb(var(--color-bg-secondary));
    --waline-bg-color-hover: rgb(var(--color-text-primary) / 0.06);
    --waline-border-color: rgb(var(--color-border-primary));
    --waline-light-grey: rgb(var(--color-text-secondary));
    --waline-dark-grey: rgb(var(--color-text-secondary));
    --waline-avatar-size: 2.75rem;
    --waline-avatar-radius: 0.75rem;
    --waline-bq-color: rgb(var(--color-bg-secondary));
    --waline-code-bg-color: rgb(var(--color-bg-secondary));
    --waline-info-color: rgb(var(--color-text-secondary));
    --waline-info-bg-color: rgb(var(--color-bg-secondary) / 0.7);
    --waline-warning-color: rgb(var(--color-accent));
    --waline-warning-bg-color: rgb(var(--color-accent) / 0.1);
    --waline-badge-color: rgb(var(--color-accent));
    --waline-font-size: 0.9rem;
    --waline-box-shadow: 0 10px 28px rgb(var(--color-text-primary) / 0.06);
    font-family: inherit;
  }

  #waline * {
    font-family: inherit;
  }

  /* 深色：必须高于 #waline 的特异性，才能盖过 Waline 自身注入的深色变量 */
  html[data-theme='dark'] #waline {
    --waline-bg-color-hover: rgb(255 255 255 / 0.06);
    --waline-code-bg-color: #0d1117;
    --waline-warning-bg-color: rgb(var(--color-accent) / 0.16);
    --waline-box-shadow: 0 12px 30px rgb(0 0 0 / 0.45);
  }

  /* ─── 输入面板（昵称/邮箱 + 编辑器 + 操作栏） ─── */
  #waline .wl-panel {
    border-radius: 1rem;
    border-color: rgb(var(--color-border-primary) / 0.55);
    background: rgb(var(--color-bg-primary) / 0.55);
    box-shadow: 0 10px 28px rgb(var(--color-text-primary) / 0.05);
  }

  html[data-theme='dark'] #waline .wl-panel {
    background: rgb(var(--color-bg-primary) / 0.65);
  }

  #waline .wl-header {
    border-bottom: 1px solid rgb(var(--color-border-primary) / 0.45);
    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
    padding: 0 0.75rem;
  }

  #waline .wl-header label {
    color: rgb(var(--color-text-secondary));
    font-size: 0.72rem;
  }

  #waline .wl-header input {
    color: rgb(var(--color-text-primary));
    font-size: 0.8rem;
    padding: 0.55em 0.2em;
  }

  #waline .wl-header input:focus {
    background: transparent;
    border-bottom: 1px solid rgb(var(--color-accent));
  }

  #waline .wl-editor {
    box-sizing: border-box;
    min-height: 9em;
    margin: 0.75em 0.5em;
    padding: 1rem;
    border: 1px solid rgb(var(--color-border-primary) / 0.4);
    border-radius: 1rem;
    background: rgb(var(--color-text-primary) / 0.025);
    color: rgb(var(--color-text-primary));
    font-size: 0.9rem;
    line-height: 1.6;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  #waline .wl-editor:focus {
    border-color: rgb(var(--color-accent));
    background: rgb(var(--color-bg-secondary) / 0.35);
  }

  #waline .wl-footer {
    margin: 0.4rem 0.75em 0.6rem;
  }

  #waline .wl-action {
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  #waline .wl-action:hover {
    transform: translateY(-1px);
  }

  /* ─── 提交按钮：pill 药丸（同 Twikoo .tk-btn） ─── */
  #waline .wl-btn {
    padding: 0.4rem 1.15rem;
    border-radius: 2rem;
    border-color: rgb(var(--color-accent) / 0.35);
    background: rgb(var(--color-accent) / 0.08);
    color: rgb(var(--color-accent));
    font-weight: 600;
    font-size: 0.8rem;
  }

  #waline .wl-btn:hover,
  #waline .wl-btn:active {
    border-color: rgb(var(--color-accent) / 0.6);
    background: rgb(var(--color-accent) / 0.16);
    color: rgb(var(--color-accent));
  }

  #waline .wl-btn.primary {
    border-color: rgb(var(--color-accent));
    background: rgb(var(--color-accent));
    color: #fff;
  }

  #waline .wl-btn.primary:hover,
  #waline .wl-btn.primary:active {
    background: rgb(var(--color-accent));
    color: #fff;
    box-shadow: 0 4px 14px rgb(var(--color-accent) / 0.3);
  }

  /* ─── 评论列表卡片 ─── */
  #waline .wl-comment {
    gap: 0.875rem;
    align-items: flex-start;
  }

  #waline .wl-avatar {
    flex-shrink: 0;
    overflow: hidden;
  }

  #waline .wl-card {
    border-bottom: 1px solid rgb(var(--color-border-primary) / 0.25);
  }

  #waline .wl-card .wl-head .wl-nick {
    color: rgb(var(--color-accent));
    font-weight: 600;
  }

  #waline .wl-card span.wl-nick {
    color: rgb(var(--color-text-secondary));
  }

  #waline .wl-card .wl-time {
    color: rgb(var(--color-text-primary) / 0.45);
  }

  #waline .wl-card .wl-content {
    color: rgb(var(--color-text-primary));
    font-size: 0.9rem;
    line-height: 1.75;
  }

  /* 回复嵌套：左侧 accent 细线（同 Twikoo .tk-replies） */
  #waline .wl-card-item .wl-card-item {
    margin-left: 0.5rem;
    padding-left: 1rem;
    border-left: 2px solid rgb(var(--color-accent) / 0.18);
  }

  /* ─── 评论内容内排版：行内代码 / 代码块 / 引用 ─── */
  #waline .wl-content code {
    border-radius: 0.4rem;
    padding: 0.1em 0.4em;
    font-size: 0.85em;
    background: rgb(var(--color-text-primary) / 0.06);
    color: rgb(var(--color-accent));
  }

  #waline .wl-content pre {
    border-radius: 0.75rem;
    background: rgb(var(--color-bg-secondary));
    color: rgb(var(--color-text-primary));
    padding: 0.85rem 1rem;
    overflow-x: auto;
  }

  #waline .wl-content pre code {
    padding: 0;
    background: transparent;
    color: inherit;
  }

  #waline .wl-content blockquote {
    margin: 0.5rem 0;
    padding: 0.5rem 0.9rem;
    border-left: 3px solid rgb(var(--color-accent) / 0.5);
    border-radius: 0.5rem;
    background: rgb(var(--color-bg-secondary) / 0.6);
  }

  #waline .wl-content img {
    max-width: 100%;
    border-radius: 0.75rem;
  }

  /* ─── 表情弹层 ─── */
  #waline .wl-emoji-popup {
    z-index: 30;
    border-radius: 0.75rem;
    background: rgb(var(--color-bg-primary));
    border-color: rgb(var(--color-border-primary) / 0.6);
    box-shadow: 0 14px 36px rgb(var(--color-text-primary) / 0.18);
  }

  html[data-theme='dark'] #waline .wl-emoji-popup {
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.6);
  }

  #waline .wl-emoji-popup .wl-tabs {
    border-radius: 0.5rem;
  }

  #waline .wl-emoji-popup button:hover {
    background: rgb(var(--color-accent) / 0.14);
  }

  /* 顶部排序/计数栏 */
  #waline .wl-meta-head {
    padding-bottom: 0.75rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid rgb(var(--color-border-primary) / 0.25);
  }
</style>
