---
import { RelativeDate } from './RelativeDate'
import ReadCount from './ReadCount.astro'

interface Props {
  date: Date
  words: number
  readingMinutes: number
  postPath?: string
  postTitle?: string
  class?: string
}

const { date, words, readingMinutes, postPath, postTitle, class: className } = Astro.props
---

<div class="flex flex-wrap gap-2.5 text-sm text-secondary" class:list={[className]}>
  <div>
    <svg
      class="inline-block -mt-[1px]"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect
        width="18"
        height="18"
        x="3"
        y="4"
        rx="2"></rect><path d="M3 10h18"></path></svg
    >
    <RelativeDate date={date} client:idle />
  </div>
  <div>
    <svg
      class="inline-block -mt-[1px]"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
      ></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"
      ></line><line x1="16" y1="17" x2="8" y2="17"></line></svg
    >
    <span>{words} 字</span>
  </div>
  <div>
    <svg
      class="inline-block -mt-[1px]"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg
    >
    <span>{Math.ceil(readingMinutes)} 分钟</span>
  </div>
  {
    postPath && postTitle && (
      <ReadCount postPath={postPath} postTitle={postTitle} class="flex items-center gap-1" />
    )
  }
</div>
