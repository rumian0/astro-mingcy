---
import type { CollectionEntry } from 'astro:content'
import PostCard from './PostCard.astro'

interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props
---

<div class="post-list">
  <div class="grid grid-cols-1 gap-12">
    {posts.map((post, i) => <PostCard entry={post} index={i} />)}
  </div>
</div>

<script>
  // 首页文章卡片交互：鼠标跟随高光 + 点击弹簧弹起
  // 委托到 document（Swup 切页后 DOM 重建也无需重新绑定），带一次性守卫防重复注册
  const glowBoundKey = '__postListGlowBound'
  if (!(window as unknown as Record<string, boolean>)[glowBoundKey]) {
    ;(window as unknown as Record<string, boolean>)[glowBoundKey] = true

    // 鼠标跟随高光：仅桌面端（粗指针设备无 hover，跳过）
    if (!window.matchMedia('(pointer: coarse)').matches) {
      let ticking = false
      document.addEventListener(
        'mousemove',
        (e) => {
          const card = (e.target as Element | null)?.closest(
            '.post-list .card-glass',
          ) as HTMLElement | null
          if (!card) return
          if (ticking) return
          ticking = true
          requestAnimationFrame(() => {
            const rect = card.getBoundingClientRect()
            card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`)
            card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`)
            ticking = false
          })
        },
        { passive: true },
      )
    }

    // 点击卡片 → 弹簧"弹出"（过渡由 .card-press 的 overshoot 曲线完成）
    document.addEventListener(
      'click',
      (e) => {
        const link = (e.target as Element | null)?.closest('.post-list a[href]')
        if (!link) return
        const card = link.closest('.card-glass')
        if (!card) return
        card.classList.add('card-press')
      },
      true,
    )
  }
</script>
