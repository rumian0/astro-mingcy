---
// 文章页右下角评论悬浮按钮：点击平滑滚动到评论区
// 位置在 BackToTopFAB（fixed right-4 bottom-6 z-10）上方；仅在有评论区（#comment-block）的文章页显示
// 滚动目标为当前激活的评论引擎容器（Twikoo 或 Waline）
---

<div id="comment-fab" class="comment-fab" data-hidden="true">
  <button type="button" class="comment-fab-btn" aria-label="评论">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><path
        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
      ></path></svg
    >
  </button>
</div>

<style is:global>
  .comment-fab {
    position: fixed;
    right: 1rem;
    /* BackToTopFAB 占 bottom 1.5rem + 2.5rem 高，评论按钮放其上方留 1rem 间距 */
    bottom: 5rem;
    z-index: 10;
  }
  .comment-fab[data-hidden='true'] {
    display: none;
  }
  .comment-fab-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid rgb(var(--color-border-primary));
    background: rgb(var(--color-bg-primary) / 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px rgb(var(--color-text-primary) / 0.08);
    color: rgb(var(--color-text-secondary));
    cursor: pointer;
    opacity: 0;
    transform: translateY(10px) scale(0.7);
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .comment-fab.is-visible .comment-fab-btn {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .comment-fab-btn:hover {
    color: rgb(var(--color-accent));
    border-color: rgb(var(--color-accent) / 0.5);
    box-shadow: 0 0 18px rgb(var(--color-accent) / 0.25);
  }
  .comment-fab-btn svg {
    width: 1.15rem;
    height: 1.15rem;
  }
</style>

<script is:inline>
  // 评论悬浮按钮：滚动超过 100px 后浮现，点击平滑滚动到当前激活的评论区
  // 时序：本脚本位于 <main> 开头、文章内容之前执行，此时 #comment-block（评论区）尚未被浏览器解析，
  //       故不能立即检查，需在 DOM 就绪 / 延迟兜底 / Swup 切页后各检查一次。
  // 防泄漏：window 级监听（scroll/click）用一次性守卫只注册一次，Swup 切页重建 main 时只更新当前按钮。
  ;(function () {
    var fab = document.getElementById('comment-fab')
    if (!fab) return // 非文章页无此元素

    function show() {
      if (document.getElementById('comment-block')) {
        fab.removeAttribute('data-hidden')
      }
    }

    if (!window.__commentFabBound) {
      window.__commentFabBound = true

      // 滚动浮现（document 委托到当前页面的 fab，Swup 切页后自动指向新元素）
      var ticking = false
      window.addEventListener(
        'scroll',
        function () {
          if (ticking) return
          ticking = true
          requestAnimationFrame(function () {
            var el = document.getElementById('comment-fab')
            var y = window.scrollY || document.documentElement.scrollTop
            if (el) el.classList.toggle('is-visible', y > 100)
            ticking = false
          })
        },
        { passive: true },
      )

      // 点击 → 平滑滚动到当前激活的评论引擎容器（document 委托）
      document.addEventListener('click', function (e) {
        if (!e.target.closest('.comment-fab-btn')) return
        var target =
          document.querySelector('#comment-block .comment-driver.is-active') ||
          document.getElementById('comment-block')
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' })
      })
    }

    // 各时机检查并显示
    show()
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', show)
    } else {
      // 直接加载时 #comment-block 稍后解析，延迟兜底
      setTimeout(show, 100)
      setTimeout(show, 400)
    }
    document.addEventListener('swup:page:view', show)
    document.addEventListener('astro:page-load', show)
  })()
</script>
