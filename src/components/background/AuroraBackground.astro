---
export interface Props {
  showRadialGradient?: boolean
  className?: string
}

const { showRadialGradient = true, className = '' } = Astro.props
---

<div
  class:list={[
    'aurora-container absolute inset-0 overflow-hidden pointer-events-none -z-1',
    className,
  ]}
  aria-hidden="true"
>
  <div class="aurora-layer aurora-layer-1"></div>
  <div class="aurora-layer aurora-layer-2"></div>
  <div class="aurora-layer aurora-layer-3"></div>
  {showRadialGradient && <div class="aurora-radial-overlay" />}
</div>

<style>
  .aurora-container {
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 40%,
      rgba(0, 0, 0, 0.3) 70%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 40%,
      rgba(0, 0, 0, 0.3) 70%,
      transparent 100%
    );
  }

  .aurora-layer {
    position: absolute;
    inset: -50%;
    opacity: 0.4;
    mix-blend-mode: normal;
    animation: aurora-flow var(--aurora-duration, 60s) linear infinite;
  }

  .aurora-layer-1 {
    background: radial-gradient(
      ellipse 80% 50% at 50% 0%,
      rgb(from var(--color-accent, 245 85 85) r g b / 0.15) 0%,
      transparent 70%
    );
    animation-direction: normal;
  }

  .aurora-layer-2 {
    background: radial-gradient(
      ellipse 60% 40% at 30% 20%,
      rgb(from var(--color-accent, 245 85 85) r g b / 0.1) 0%,
      transparent 60%
    );
    animation-duration: calc(var(--aurora-duration, 60s) * 0.8);
    animation-direction: reverse;
  }

  .aurora-layer-3 {
    background: radial-gradient(
      ellipse 70% 45% at 70% 10%,
      rgb(from var(--color-accent, 245 85 85) r g b / 0.08) 0%,
      transparent 60%
    );
    animation-duration: calc(var(--aurora-duration, 60s) * 1.2);
    animation-direction: alternate;
  }

  .aurora-radial-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 100% 60% at 50% 0%,
      transparent 20%,
      rgb(from var(--color-bg-root, 250 250 250) r g b / 0.3) 100%
    );
  }

  @keyframes aurora-flow {
    from {
      transform: translate(0%, 0%) scale(1);
    }
    to {
      transform: translate(5%, 3%) scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora-layer {
      animation: none;
    }
  }
</style>
