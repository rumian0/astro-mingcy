---
interface Props {
  title: string
  url: string
  desc?: string
  image?: string
}

const { title, url, desc, image } = Astro.props
const hostname = new URL(url).hostname
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class="group flex items-center gap-4 rounded-xl border border-primary/20 bg-secondary/30 p-4 not-prose transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-accent/10"
>
  {
    image && (
      <img
        src={image}
        alt={title}
        class="h-12 w-12 flex-shrink-0 rounded-full object-cover"
        loading="lazy"
      />
    )
  }
  <div class="min-w-0 flex-1">
    <p class="truncate font-medium group-hover:text-accent">{title}</p>
    {desc && <p class="truncate text-xs text-secondary">{desc}</p>}
    <p class="truncate text-xs text-secondary/60">{hostname}</p>
  </div>
</a>
